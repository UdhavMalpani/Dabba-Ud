BATT_LOW_VOLT,21.0
BATT_CRT_VOLT,19.8
BATT_FS_VOLTSRC,1
BATT_LOW_MAH,780
BATT_CRT_MAH,450
BATT_FS_LOW_ACT,2
BATT_FS_CRT_ACT,1
INS_HNTCH_ENABLE,1
