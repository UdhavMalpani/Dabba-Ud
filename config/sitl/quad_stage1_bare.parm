# Project 8 - ArduPilot SITL parameter file - STAGE 1 BARE 5-inch quad (~1.13 kg)
# Self-contained SITL file: do NOT also load config/ardupilot/*.param (those set SERIAL3/6 for the real
# SpeedyBee board, which would disable the SITL simulated GPS on SERIAL3).
#
# Run from the ardupilot source tree (Linux/WSL), IIITH sports-ground home 17.4455,78.3489,540 m ASL, heading 0:
#   Tools/autotest/sim_vehicle.py -v ArduCopter -f quad --model "quad:/abs/path/UAV-Design/config/sitl/project8_5in_bare.json" \
#       --custom-location=17.4455,78.3489,540,0 -w \
#       --add-param-file=/abs/path/UAV-Design/config/sitl/quad_stage1_bare.parm --console --map
# If the frame-JSON model path is not accepted by your ArduPilot version, drop the --model argument
# (stock "quad" physics; mass then is NOT 1.13 kg - only control/failsafe logic is representative).
#
# SITL notes:
#   * SITL mass/inertia/thrust come from the frame JSON (--model), not from parameters.
#   * Failsafe tests at the MAVProxy prompt:  param set SIM_RC_FAIL 1  (RC loss -> expect RTL)
#                                             param set SIM_RC_FAIL 0  (restore)
#   * VERSION NOTES: SIM_GPS_* became SIM_GPS1_* in 4.6; SIM_ACC1_RND/SIM_GYR1_RND are the 4.x per-IMU names.

# ---------------- Simulated environment ----------------
# 6S full pack
SIM_BATT_VOLTAGE,25.2
SIM_BATT_CAP_AH,2.6
# Calm-ish day for Stage 1 hover/loiter checks: 2 m/s from the west, light turbulence
SIM_WIND_SPD,2
SIM_WIND_DIR,270
SIM_WIND_TURB,0.5
# Simulated bidirectional-DShot RPM so INS_HNTCH_MODE=3 tracks in SITL
SIM_ESC_TELEM,1
# Vibration: noise + motor-driven vibration (exercises the harmonic notch and VIBE logging)
SIM_ACC1_RND,0.5
SIM_GYR1_RND,0.05
SIM_VIB_MOT_MAX,200
SIM_BARO_RND,0.1
SIM_GPS_NUMSATS,14
SIM_GPS_HDOP,90
SIM_GPS_NOISE,0.3

# ---------------- Vehicle (mirrors stage1_bare_5in.param, minus board-specific I/O) ----------------
FRAME_CLASS,1
FRAME_TYPE,1
MOT_SPIN_ARM,0.07
MOT_SPIN_MIN,0.10
MOT_SPIN_MAX,0.95
