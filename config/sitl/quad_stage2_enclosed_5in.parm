# Project 8 - ArduPilot SITL parameter file - STAGE 2 ENCLOSED 5-inch ducted quad, RETRACTABLE LEGS (1.905 kg)
# Self-contained SITL file: do NOT also load config/ardupilot/*.param (board-specific SERIAL3/6 settings
# would disable the SITL GPS on SERIAL3).
#
# Run from the ardupilot source tree (Linux/WSL), IIITH sports-ground home 17.4455,78.3489,540 m ASL, heading 0:
#   Tools/autotest/sim_vehicle.py -v ArduCopter -f quad --model "quad:/abs/path/UAV-Design/config/sitl/project8_5in_enclosed.json" \
#       --custom-location=17.4455,78.3489,540,0 -w \
#       --add-param-file=/abs/path/UAV-Design/config/sitl/quad_stage2_enclosed_5in.parm --console --map
# Then at the MAVProxy prompt:
#   wp load /abs/path/UAV-Design/missions/iiith_5in_enclosed_mission.waypoints
#   mode GUIDED ; arm throttle ; mode AUTO ; rc 3 1500      (AUTO start)
# Failsafe drills:  param set SIM_RC_FAIL 1   -> expect RTL (FS_THR)        ; param set SIM_RC_FAIL 0 to restore
#                   param set SIM_BATT_VOLTAGE 20.5 -> expect BATT low -> RTL ; 19.5 -> critical -> LAND
#                   fly LOITER past 120 m radius or above 40 m             -> expect FENCE breach -> RTL
# If your ArduPilot build rejects the frame JSON path, omit --model (stock quad physics; logic-only test).
# VERSION NOTES: SIM_GPS_* -> SIM_GPS1_* in 4.6; SIM_ACC1_RND/SIM_GYR1_RND are the 4.x per-IMU names.

# ---------------- Simulated environment (design case: 15 km/h crosswind + turbulence) ----------------
SIM_BATT_VOLTAGE,25.2
SIM_BATT_CAP_AH,2.6
# 15 km/h = 4.17 m/s from the west (crosswind on the N-S mission legs)
SIM_WIND_SPD,4.17
SIM_WIND_DIR,270
SIM_WIND_TURB,1.5
SIM_ESC_TELEM,1
SIM_ACC1_RND,0.8
SIM_GYR1_RND,0.08
SIM_VIB_MOT_MAX,250
SIM_BARO_RND,0.1
SIM_GPS_NUMSATS,14
SIM_GPS_HDOP,90
SIM_GPS_NOISE,0.3

